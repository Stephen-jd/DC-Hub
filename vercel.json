{
  "version": 2,
  "env": {
    "VERCEL": "1"
  },
  "builds": [
    {
      "src": "dc_master/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.12"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dc_master/wsgi.py"
    }
  ]
}
